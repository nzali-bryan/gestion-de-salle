<form method="post" class="btn btn-outline-danger px-1" action="{{ path('app_console_delete', {'id': console.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ console.id) }}">
    <button class="btn">Supprimer</button>
</form>

{% extends 'base.html.twig' %}


{% block body %}
    <h1>créer une nouvelle console</h1>


    {{ form_start(form) }}

    <div class="mb-3">
        {{ form_label(form.nom) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-select form_control'}}) }}
        {{ form_errors(form.nom) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.type) }}
    {{ form_widget(form.type,{'attr': {'placeholder':'PlayStation , Xbox','class': 'form-select form_control'}}) }}
        {{ form_errors(form.type) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.tarifHeure) }}
        {{ form_widget(form.tarifHeure, {'label': 'Tarif Heure (FCFA)','attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.tarifHeure) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.tarif15min) }}
        {{ form_widget(form.tarif15min, {'label': 'Tarif Minute (15MIN/FCFA)','attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.tarif15min) }}
    </div>

    <button class="btn btn-primary">Créer un Compte</button>

    {{ form_end(form) }}

    <a href="{{ path('app_console_index') }}">Voir les consoles</a>
{% endblock %}

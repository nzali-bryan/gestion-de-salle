{% extends 'base.html.twig' %}

{% block title %}Maxi Gaming{% endblock %}

{% block body %}
<style>

</style>

    {{ form_start(form) }}

    <div class="mb-3">
        {{ form_label(form.nom) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.nom) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.email) }}
        {{ form_widget(form.email, {'label': 'Email','attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.roles) }}
        {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.roles) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.password) }}
        {{ form_widget(form.password, {'attr': {'class': 'form-control form_control'}}) }}
        {{ form_errors(form.password) }}
    </div>

    <button class="btn btn-primary">Créer un Compte</button>

    {{ form_end(form) }}
{% endblock %}

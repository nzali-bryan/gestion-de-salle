{% extends 'base.html.twig' %}

{% block title %}Gestion des Sessions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css1/dashboard.css') }}">
    <link rel="stylesheet" href="https://jsdelivr.net">
{% endblock %}

{% block body %}
<div class="mg-dashboard bg-light min-vh-100 pb-5">


{# Si la journée n'est PAS ouverte, on affiche l'alerte #}
{% if not DejaOuvert %}
    <div class="container-fluid pt-3 px-3">
        <div class="card border-0 shadow-sm bg-danger text-white rounded-4 mb-3">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3">⚠️</span>
                    <div>
                        <h6 class="fw-bold mb-0">Journée non ouverte</h6>
                        <small class="text-white-50">Ouvrez la journée pour gérer les sessions.</small>
                    </div>
                </div>
                <a href="{{ path('new_journee') }}" class="btn btn-light btn-sm fw-bold text-danger rounded-3 px-3">
                    Ouvrir
                </a>
            </div>
        </div>
    </div>
{% else %}
    <section class="mg-day-card">
        <div class="mg-day-info">
            <div class="mg-day-label">
                <span class="status-dot"></span>
                JOURNÉE OUVERTE
            </div>
            <h2>{{ journee.date|format_date(locale='fr', pattern='dd MMMM yyyy') }}</h2>
            <p><i class="bi bi-clock"></i> Ouverte depuis {{ journee.createdAt|date('H:i') }}</p>
        </div>
        {# <button class="mg-close-day">
            Fermer la journée
        </button> #}
        <a href="{{ path('close_journee', {'id': journee.id}) }}" class="mg-close-day">
            Fermer la journée
        </a>
    </section>
{% endif %}


    {# ================= 2. EN-TÊTE DE LA PAGE ================= #}
    <div class="container-fluid px-3 pt-2 mb-3">
        <span class="mg-overline text-uppercase small fw-bold text-primary">Temps Réel</span>
        <h1 class="h3 fw-bold text-dark mb-0">Sessions de Jeu</h1>
    </div>

    {# ================= 3. FILTRES RAPIDES MOBILE ================= #}
    <div class="container-fluid px-3 mb-4">
        <div class="d-flex gap-2 overflow-x-auto pb-1" style="scrollbar-width: none; -webkit-overflow-scrolling: touch;">
            <button class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold flex-shrink-0">Toutes ({{totalConsole }})</button>
            <button class="btn btn-outline-secondary border-0 bg-white shadow-sm rounded-pill px-3 btn-sm fw-semibold flex-shrink-0 text-dark">
                <span class="badge bg-danger-subtle text-danger me-1"> {{ totalEnJeu }} </span> En Jeu
            </button>
            <button class="btn btn-outline-secondary border-0 bg-white shadow-sm rounded-pill px-3 btn-sm fw-semibold flex-shrink-0 text-dark">
                <span class="badge bg-success-subtle text-success me-1"> {{totalLibre }} </span> Libres
            </button>
        </div>
    </div>

    {# ================= 4. GRILLE DES CONSOLES ET SESSIONS ================= #}
    <div class="container-fluid px-3">
        <div class="row g-3">

            {# --- CARTE CONSOLE 1 : EN COURS (SIMULATION CHRONO) --- #}
        {% for Console in Consoles %}
            {% if Console.statut === 'En jeu' %}
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-3">
                        <!-- Top Card -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; font-size: 1.3rem;">
                                    <i class="bi bi-controller"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark"> {{Console.nom }} </h5>
                                    <h6 class=" fw-semibold mb-0 text-dark">{{Console.type}}</h6>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">En jeu</span>
                                </div>
                            </div>
                            {# Je recupère la derbière session qui correspont à la console  #}
                            {% set derniereSession = Console.sessionsJeus|last %}
                            <div class="text-end">
                        
                                <span class="text-muted d-block small">Montant</span>
                                <turbo-frame id="frame_session_{{ derniereSession.id }}">
                                    <strong class="text-dark fs-5">{{derniereSession.montant}}</strong>
                                </turbo-frame>
                            </div>
                        </div>



<div class="bg-light rounded-3 p-3 text-center mb-3 session-timer" 
    data-session-id="{{ Console.id }}"
     data-date-debut="{{ derniereSession.debut|date('H:i:s') }}" 
     data-date-fin="{{ derniereSession.fin|date('H:i:s') }}"
     data-console-nom= "{{Console.nom}}">
    
    <span class="text-muted small text-uppercase fw-semibold tracking-wider">Temps restant</span>
    <div class="display-5 fw-bold text-dark my-1 tracking-tight countdown-display">--:--</div>
    
    <div class="progress bg-secondary-subtle rounded-pill" style="height: 6px;">
        <div class="progress-bar progress-bar-display progress-bar-striped progress-bar-animated bg-danger rounded-pill" role="progressbar" style="width: 0%"></div>
    </div>
</div>
                        <!-- Actions rapides sur Mobile -->
                        <div class="row g-2">
                            <div class="col-6">
                                <a href="{{path ('add_time',{'id':Console.id} )}}" class="btn btn-outline-primary w-100 py-2.5 rounded-3 fw-bold btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i> +15 min
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="{{path ('close_console',{'id':Console.id})}}" class=" btn-arreter btn btn-danger w-100 py-2.5 rounded-3 fw-bold btn-sm">
                                    <i class="bi bi-stop-fill me-1"></i> Arrêter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            {# --- CARTE CONSOLE 2 : DISPONIBLE (LANCEMENT DE SESSION) --- #}
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-3">
                        <!-- Top Card -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-secondary-subtle text-secondary rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; font-size: 1.3rem;">
                                    <i class="bi bi-controller"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">{{Console.nom}}</h5>
                                <h6 class=" fw-semibold mb-0 text-dark">{{Console.type}}</h6>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Disponible</span>
                                </div>
                            </div>
                            <i class="bi bi-play-circle-fill text-success fs-3"></i>
                        </div>
                        {# pour recuperer le formulaire de la console  #}
                        {# {% set consoleId =  console.id  %} #}
                                {% set Form = forms[Console.id] %}
                                {{ form_start(Form, {'attr': {'data-turbo': 'true'}}) }}

                                    <div class="mb-3">
                                        {{ form_label(Form.duree) }}
                                        {{ form_widget(Form.duree, {'attr': {'class': 'form_control form-select bg-light border-0 rounded-3 py-2 text-dark fw-medium'}}) }}
                                        {{ form_errors(Form.duree) }} 
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(Form.montant) }}
                                    {{ form_widget(Form.montant,{'attr': {'placeholder':'---FCFA','class': 'form_control border-1 rounded-3 py-2 text-dark fw-medium w-100'}}) }}
                                        {{ form_errors(Form.montant) }}
                                    </div>
                                        {{ form_widget(Form.Console, {
                                            'value': Console.id, 
                                            'attr': {'style': 'display: none;'}
                                        }) }}



                            <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-bold shadow-sm">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Lancer la session
                            </button>

                                {{ form_end(Form) }}

                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
        </div>
    </div>

    {# ================= 5. BARRE DE NAVIGATION FIXE MOBILE ================= #}
    <nav class="mg-bottom-nav">
        <a href="{{ path('accueil') }}"><i class="bi bi-house"></i><span>Accueil</span></a>
        <a href="{{('sessions')}}" class="active"><i class="bi bi-controller"></i><span>Sessions</span></a>
        <a href="{{ path('transaction') }}"><i class="bi bi-wallet2"></i><span>Finances</span></a>
        <a href="#"><i class="bi bi-bar-chart-fill"></i><span>Bilans</span></a>
    </nav>

</div>



<script>
     // script pour afficher le teps restant en temps réel
document.addEventListener("turbo:load", function () {
    // 1. DEMANDE D'AUTORISATION (Une seule fois au chargement si pas encore répondu)
    if ("Notification" in window && Notification.permission === "default") {
        Notification.requestPermission();
    }

    // 2. SÉCURITÉ INTERVALLE (Évite de cumuler les boucles avec les rechargements Turbo)
    if (window.timerInterval) clearInterval(window.timerInterval);
    
    updateTimers();
    window.timerInterval = setInterval(updateTimers, 1000);
});

function updateTimers() {
    document.querySelectorAll('.session-timer').forEach(timer => {
        const debutStr = timer.getAttribute('data-date-debut');
        const finStr = timer.getAttribute('data-date-fin');
        const consoleNom = timer.getAttribute('data-console-nom') || 'Console';
        if (!debutStr || !finStr) return;

        const now = new Date();
        const createDate = (timeStr) => {
            const [h, m, s] = timeStr.split(':').map(Number);
            return new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m, s);
        };

        const debut = createDate(debutStr);
        let fin = createDate(finStr);
        if (fin < debut) fin.setDate(fin.getDate() + 1);

        const tempsTotal = fin - debut;
        const tempsRestant = fin - now;
        const displayEl = timer.querySelector('.countdown-display');
        const progressEl = timer.querySelector('.progress-bar-display');

        // --- A. ALERTE DES 5 MINUTES ---
        // 300000 ms = 5 minutes
        if (tempsRestant > 0 && tempsRestant <= 300000) {
            if (!timer.dataset.notifieAlerte && Notification.permission === "granted") {
                new Notification("Temps bientôt écoulé !", {
                    body: `Il reste moins de 5 minutes sur la ${consoleNom}.`,
                });
                timer.dataset.notifieAlerte = "true"; // Bloque le spam
            }
        }

        // --- B. TEMPS ÉCOULÉ : APPAREIL TERMINÉ (0 SECONDE) ---
        if (tempsRestant <= 0) {
            if (displayEl) {
                displayEl.innerHTML = "Terminé !";
                displayEl.classList.replace('text-dark', 'text-danger');
            }
            if (progressEl) {
                progressEl.style.width = "100%";
                progressEl.classList.remove('progress-bar-animated');
            }

            // 1. Notification de fin de session
            if (!timer.dataset.notifieFin && Notification.permission === "granted") {
                new Notification("Session expirée !", {
                    body: `Le temps est totalement écoulé sur la ${consoleNom}.`,
                });
                timer.dataset.notifieFin = "true";
            }
            return;
        }

        // --- C. RÉINITIALISATION (Si du temps est rajouté via +15 min) ---
        if (tempsRestant > 300000) {
            timer.removeAttribute('data-notifieAlerte');
            timer.removeAttribute('data-notifieFin');
            timer.removeAttribute('data-requeteEnvoyee');
        }

        // --- D. MISE À JOUR DE LA BARRE ET DU TEXTE ---
        if (progressEl && tempsTotal > 0) {
            const progression = 100 - ((tempsRestant / tempsTotal) * 100);
            progressEl.style.width = Math.max(0, progression) + "%";
        }

        const h = Math.floor(tempsRestant / 3600000);
        const m = Math.floor((tempsRestant % 3600000) / 60000);
        const s = Math.floor((tempsRestant % 60000) / 1000);
        const pad = (n) => String(n).padStart(2, '0');
        
        if (displayEl) {
            displayEl.innerHTML = h > 0 ? `${pad(h)}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
        }
    });
}

</script>
{% endblock %}
